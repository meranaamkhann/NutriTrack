NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nutritrack:nutritrack@localhost:5432/nutritrack
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173
EXPORT_STORAGE_DIR=./storage/exports
EXPORT_TOKEN_TTL_MINUTES=15
AI_PROVIDER_API_KEY=replace-me
AI_DAILY_REQUEST_LIMIT_PER_USER=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=5
