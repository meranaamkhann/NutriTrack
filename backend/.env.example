NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nutritrack:nutritrack@localhost:5432/nutritrack

# Generate your own: openssl rand -hex 32  (must be 32+ characters — the
# string below is intentionally obviously-fake-length so you don't forget)
JWT_ACCESS_SECRET=replace-this-with-a-real-random-64-char-hex-string-0000

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

EXPORT_STORAGE_DIR=./storage/exports
EXPORT_TOKEN_TTL_MINUTES=15

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=5
# Set this to enable rate limiting shared across multiple server instances.
# Leave blank for local dev / a single instance — falls back to an in-memory
# store automatically.
REDIS_URL=

# Leave all three blank to run in dev mode: verification/reset emails are
# logged to the console instead of sent, so you can still get the link.
# Fill all three in to actually send email via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriTrack <no-reply@nutritrack.local>

# Leave blank to run the AI quick-add feature in stub mode (it returns no
# parsed items but the review-before-save flow still works end-to-end).
# Set it to enable real natural-language food parsing.
ANTHROPIC_API_KEY=
AI_DAILY_REQUEST_LIMIT_PER_USER=30

# Argon2id cost parameters. These defaults are a reasonable production
# floor; raise ARGON2_MEMORY_COST_KB if your server has the RAM to spare.
ARGON2_MEMORY_COST_KB=19456
ARGON2_TIME_COST=2
